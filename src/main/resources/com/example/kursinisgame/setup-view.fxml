<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="314.0" prefWidth="394.0" stylesheets="@background_style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kursinisgame.controllers.SetUpController">
   <children>
      <Text fill="#128d56" layoutX="16.0" layoutY="59.0" strokeType="OUTSIDE" strokeWidth="0.0" text="STOCK MARKET TRADING GAME" wrappingWidth="377.8125">
         <font>
            <Font name="Arial" size="23.0" />
         </font>
      </Text>
      <TextField fx:id="startBalanceTF" layoutX="130.0" layoutY="81.0" promptText="Start Balance" style="-fx-background-color: #FFFF;" />
      <TextField fx:id="startAssetPriceTF" layoutX="130.0" layoutY="129.0" promptText="Start Asset Price" style="-fx-background-color: #FFFF;" />
      <Button fx:id="startGameB" layoutX="162.0" layoutY="267.0" mnemonicParsing="false" onAction="#StartGame" prefWidth="86.0" style="-fx-background-color: #05714B;" text="START GAME" textFill="WHITE" />
      <ComboBox fx:id="modelCB" layoutX="130.0" layoutY="179.0" prefWidth="150.0" promptText="Model" style="-fx-background-color: #FFFFFF;" />
      <ComboBox fx:id="assetTypeCB" layoutX="130.0" layoutY="223.0" prefWidth="150.0" promptText="Asset Type" style="-fx-background-color: #FFFFFF;" />
   </children>
</AnchorPane>

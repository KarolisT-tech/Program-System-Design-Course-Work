<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="294.0" prefWidth="484.0" stylesheets="@background_style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kursinisgame.controllers.MainForm">
   <children>
      <TextField fx:id="myBalanceTF" layoutX="27.0" layoutY="90.0" prefHeight="38.0" prefWidth="117.0" style="-fx-background-color: #FFFFFF;" />
      <TextField fx:id="myAssetsTF" layoutX="161.0" layoutY="90.0" prefHeight="38.0" prefWidth="117.0" style="-fx-background-color: #FFFFFF;" />
      <TextField fx:id="assetPriceTf" layoutX="27.0" layoutY="159.0" prefHeight="38.0" prefWidth="117.0" style="-fx-background-color: #FFFFFF;" />
      <TextField fx:id="assetPriceTaxTF" layoutX="161.0" layoutY="159.0" prefHeight="38.0" prefWidth="117.0" style="-fx-background-color: #FFFFFF;" />
      <Text layoutX="27.0" layoutY="86.0" strokeType="OUTSIDE" strokeWidth="0.0" text="My Balance" />
      <Text layoutX="161.0" layoutY="86.0" strokeType="OUTSIDE" strokeWidth="0.0" text="My Assets" />
      <Text layoutX="27.0" layoutY="155.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Asset Price" />
      <Text layoutX="163.0" layoutY="155.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Asset Price With Tax" />
      <Button fx:id="buyB" layoutX="27.0" layoutY="251.0" mnemonicParsing="false" onAction="#Buy" style="-fx-background-color: #05714B;" text="BUY" textFill="WHITE" />
      <Button fx:id="holdB" layoutX="210.0" layoutY="251.0" mnemonicParsing="false" onAction="#Hold" style="-fx-background-color: #05714B;" text="HOLD" textFill="WHITE" />
      <Button fx:id="sellB" layoutX="118.0" layoutY="251.0" mnemonicParsing="false" onAction="#Sell" style="-fx-background-color: #05714B;" text="SELL" textFill="WHITE" />
      <TextField fx:id="numberOfMovesTF" layoutX="389.0" layoutY="97.0" prefHeight="25.0" prefWidth="38.0" style="-fx-background-color: #FFFFFF;" />
      <Text layoutX="348.0" layoutY="86.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Number Of Moves Left">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Text>
      <Button fx:id="stopGameB" layoutX="387.0" layoutY="251.0" mnemonicParsing="false" onAction="#FinishGame" style="-fx-background-color: #FF2626;" text="STOP GAME" textFill="WHITE" />
      <TextField fx:id="smaTF" layoutX="112.0" layoutY="14.0" prefHeight="25.0" prefWidth="60.0" style="-fx-background-color: #FFFFFF;" />
      <Text layoutX="27.0" layoutY="31.0" strokeType="OUTSIDE" strokeWidth="0.0" text="SMA Indicator">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Text>
      <Text layoutX="196.0" layoutY="31.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Asset Buy And Sell Tax Rate">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Text>
      <TextField fx:id="taxTF" layoutX="357.0" layoutY="14.0" prefHeight="25.0" prefWidth="60.0" style="-fx-background-color: #FFFFFF;" />
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="212.0" prefWidth="385.0" stylesheets="@background_style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.kursinisgame.controllers.AssetSellerForm">
   <children>
      <Text layoutX="11.0" layoutY="90.0" strokeType="OUTSIDE" strokeWidth="0.0" text="How Many Assets Would You Like To Sell?">
         <font>
            <Font name="Arial" size="19.0" />
         </font>
      </Text>
      <TextField fx:id="assetQntTF" layoutX="119.0" layoutY="106.0" promptText="Asset Quantity" style="-fx-background-color: #FFFF;" />
      <Button fx:id="confirmB" layoutX="119.0" layoutY="156.0" mnemonicParsing="false" onAction="#Sell" style="-fx-background-color: #05714B;" text="Confirm" textFill="WHITE" />
      <Button fx:id="cancelB" layoutX="216.0" layoutY="156.0" mnemonicParsing="false" onAction="#Cancel" style="-fx-background-color: #FF2626;" text="Cancel" textFill="WHITE" />
   </children>
</AnchorPane>
